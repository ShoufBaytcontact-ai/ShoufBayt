REACT_APP_API_URL=http://localhost:8800/api
REACT_APP_SOCKET_URL=http://localhost:8800
# On Render (site + API together), leave these unset so the app uses /api
# on the same domain. Or set:
# REACT_APP_API_URL=/api
# Optional. The API can also provide Google sign-in via GET /auth/google-config
# REACT_APP_GOOGLE_CLIENT_ID=
