# Copy these into api/.env and fill with your Stripe Dashboard keys (test mode is fine to start).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# First month after launch: Premium is free for everyone until this date (ISO).
# Or set SITE_LAUNCH_AT and the free window is that date + 30 days.
# PREMIUM_FREE_UNTIL=2026-09-05T23:59:59.000+03:00
# SITE_LAUNCH_AT=2026-08-22T00:00:00.000Z
#
# How to test complimentary Premium:
# 1) Keep PREMIUM_FREE_UNTIL in the future, restart the API, open /billing.
#    GET /api/subscriptions/me should return launchPremiumFree: true.
# 2) Send a role preview now (does not wait for month end):
#    node api/scripts/send-launch-end-emails.js --test --email=you@example.com --role=USER
#    Repeat with --role=AGENT and --role=ADMIN.
#    Or use the Launch campaign card on /billing (admin) / admin subscriptions.
# 3) To simulate month end: set PREMIUM_FREE_UNTIL to a past date, restart API.
#    launchPremiumFree becomes false. Users drop to 1 self-listing.
#    Then send the real campaign:
#    node api/scripts/send-launch-end-emails.js --force

# Optional: public URL for the logo in emails (defaults to CLIENT_URL/email-logo.png)
# EMAIL_LOGO_URL=https://your-domain.com/email-logo.png

# Transactional email. Gmail needs EMAIL_USER plus a 16-character App Password (not the normal Gmail password).
# EMAIL_USER=you@gmail.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx
# EMAIL_FROM_NAME=ShoufBayt
# For production inbox delivery, prefer Resend or Brevo instead of Gmail SMTP:
# RESEND_API_KEY=
# EMAIL_FROM=ShoufBayt (no-reply) <noreply@your-domain.com>
# EMAIL_NOREPLY=noreply@your-domain.com
# Do not set EMAIL_REPLY_TO to a staff inbox. All site mail is no-reply.

# Google Sign-In (Identity Services / ID token). Create a Web client ID in Google Cloud Console.
# Authorized JavaScript origins must include http://localhost:3000 (and your live site).
# Authorized redirect URIs are not required for this popup + ID-token flow.
GOOGLE_CLIENT_ID=

# Cloudflare R2 image hosting
# Create a bucket in Cloudflare Dashboard → R2, then:
# 1) Manage R2 API Tokens → create a token with Object Read & Write
# 2) Enable public access on the bucket (R2.dev subdomain or a custom domain)
# 3) Paste the values below. After that, new photos go to Cloudflare instead of api/uploads.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=your-bucket-name-lowercase
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# Optional folder prefix inside the bucket
# CLOUDFLARE_R2_FOLDER=shoufbayt
